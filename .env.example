# Copy this file to .env and provide your own credentials.
# Never commit the resulting .env file.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Semantic-audit model used in the revision experiments.
FOURHDP_AUDIT_MODEL=gpt-4o

# Victim model; override this per experiment.
MODEL_NAME=gpt-4o-mini

FOURHDP_RANDOM_SEED=0
FOURHDP_MAX_CASES=100
FOURHDP_MAX_WORKERS=2
FOURHDP_AGENT_FILTER=financial_analyst_agent,legal_consultant_agent,medical_advisor_agent

FOURHDP_ABLATION=full
FOURHDP_FLOW_SCREENING=1
FOURHDP_ENABLE_SAFE_FAST_PATH=0
FOURHDP_STATIC_HARD_BLOCK=0
FOURHDP_SINGLE_THRESHOLD=0.7
FOURHDP_CUMULATIVE_THRESHOLD=0.9
FOURHDP_CUMULATIVE_RISK_FLOOR=0.0

FOURHDP_ASB_ENFORCE_TOOL_SURFACE=1
FOURHDP_MEMORY_CAPABILITY_GUARD=1

FOURHDP_AUDIT_TIMEOUT=30
FOURHDP_AUDIT_RETRIES=2
