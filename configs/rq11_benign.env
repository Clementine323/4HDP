# Reference profile for the expanded benign evaluation.
FOURHDP_AUDIT_MODEL=gpt-4o
FOURHDP_ABLATION=full
FOURHDP_AGENT_FILTER=all
FOURHDP_ENABLE_SAFE_FAST_PATH=1
FOURHDP_STATIC_HARD_BLOCK=1
FOURHDP_SINGLE_THRESHOLD=0.7
FOURHDP_CUMULATIVE_THRESHOLD=0.9
FOURHDP_FLOW_SCREENING=1
FOURHDP_MAX_CASES=400
FOURHDP_RANDOM_SEED=2026
